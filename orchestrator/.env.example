# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-orchestrator-enrollment-token

# Required on every run, unless .private/litellm_api_key is present.
# LITELLM_API_KEY=replace-with-gateway-api-key

# Required routing configuration.
DEMO_MESH_ID=demo_enhanced_cynapsa_demo
DEMO_MAPS_AGENT_ID=cynapsa-demo.agent-e60e59d4-3578-4614-8f4b-24f790944f58@connect.cynapsa.com
# Optional; enables the independent files agent tool.
DEMO_FILES_AGENT_ID=cynapsa-demo.agent-0a7205ad-0ab1-4536-9aea-f4f2d20241a1@connect.cynapsa.com
# Optional friendly label for the incoming client in Cynapsa traffic logs.
DEMO_CLIENT_AGENT_ID=cynapsa-demo.agent-a1a03925-809f-4ab4-8ede-aebe15022ad6@connect.cynapsa.com
DEMO_MAPS_ORIGIN=http://maps-enhanced.local
DEMO_FILES_ORIGIN=http://files-enhanced.local
DEMO_CLIENT_ORIGIN=http://client-enhanced.local
# Default: cynapsa run --config /tmp/cynapsa-private/cynapsa.json -- app:app
# Alternate ordinary HTTP mode (requires DEMO_HTTP_ACCESS_KEY and trusted ingress):
# DEMO_RUN_COMMAND=uvicorn app:app --host 0.0.0.0 --port 8000 --no-access-log

# Optional gateway overrides.
# LITELLM_BASE_URL=https://litellm.eladrave.com
# LITELLM_MODEL=chatgpt/gpt-5.6-terra-high
# Optional container-local directory for SQLite, separate from credential state.
# DEMO_MEMORY_DIRECTORY=/var/lib/cynapsa-memory
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token
