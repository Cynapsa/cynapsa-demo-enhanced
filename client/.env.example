# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-client-enrollment-token

# Required routing configuration.
DEMO_MESH_ID=demo_enhanced_cynapsa_demo
DEMO_ORCHESTRATOR_AGENT_ID=cynapsa-demo.agent-c58a757b-2c86-4da8-80a4-4b04cc6cb09b@connect.cynapsa.com
# HTTP origin used by the app and mapped to the orchestrator by the launcher.
DEMO_ORCHESTRATOR_ORIGIN=http://orchestrator-enhanced.local
# Optional: reuse a printed conversation ID to resume that chat.
# DEMO_CONVERSATION_ID=replace-with-conversation-id
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token
